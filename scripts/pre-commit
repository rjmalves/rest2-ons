#!/usr/bin/env bash
# Runs the CI lint job and the type check before each commit.
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

BIN="${BIN:-.venv/bin}"
if [ ! -x "$BIN/ruff" ]; then
  echo "pre-commit: $BIN/ruff not found; run 'uv sync --extra dev' first" >&2
  exit 1
fi

echo "==> ruff format --check"
"$BIN/ruff" format --check .
echo "==> ruff check"
"$BIN/ruff" check .
echo "==> mypy --strict"
"$BIN/mypy" --strict app main.py tests scripts/ci
echo "==> plan-structure leak gate"
"$BIN/python" scripts/ci/check_no_plan_leaks.py
echo "==> rot-proof reference gate"
"$BIN/python" scripts/ci/check_comment_refs.py
echo "==> shipped-doc path gate"
"$BIN/python" scripts/ci/check_doc_paths.py
echo "==> pre-commit checks passed."
